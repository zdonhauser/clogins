{
  "description": "clodiff session hooks — inject annotation replies, nudge review findings into the viewer, and load session state",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-replies.js\"", "timeout": 10 },
          { "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/nudge-review.js\"", "timeout": 10 }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/load-session.js\"", "timeout": 10 }
        ]
      }
    ]
  }
}
